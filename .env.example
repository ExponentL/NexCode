# Model Provider Configuration
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_NAME=gpt-4o
AGENT_MODEL_API_KEY=your-api-key-here
AGENT_MODEL_BASE_URL=https://api.openai.com/v1

# Alternative: Anthropic Claude
# AGENT_MODEL_PROVIDER=anthropic
# AGENT_MODEL_NAME=claude-3-5-sonnet-20241022
# AGENT_MODEL_API_KEY=your-anthropic-api-key
# AGENT_MODEL_BASE_URL=https://api.anthropic.com/v1

# Alternative: Google Gemini
# AGENT_MODEL_PROVIDER=gemini
# AGENT_MODEL_NAME=gemini-1.5-pro
# AGENT_MODEL_API_KEY=your-gemini-api-key
# AGENT_MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Server Configuration
SERVER_PORT=8080

# Agent Limits
AGENT_MAX_ATTEMPTS=5
AGENT_WORKSPACE_ROOT=.

